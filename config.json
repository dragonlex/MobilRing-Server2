{
  "firebase": {
    "database_url": "https://mobilring-default-rtdb.firebaseio.com",
    "google_services": "C:\\apps\\MobilRing\\AndroidApp\\app\\google-services.json",
    "auth_cache": ".auth.json"
  },
  "kobold": {
    "enabled": true,
    "base_url": "http://127.0.0.1:5001",
    "api": "openai",
    "timeout": 180,
    "max_tokens": 220,
    "max_candidates": 15
  },
  "assist": {
    "host": "0.0.0.0",
    "port": 5002,
    "max_tokens": 220,
    "temperature": 0.7
  },
  "matching": {
    "min_score": 0.22,
    "llm_min_confidence": 0.6,
    "heuristic_only_min_score": 0.45,
    "allow_same_user": true,
    "interval_sec": 60,
    "closed_skip": true
  },
  "logging": {
    "file": "matcher.log",
    "level": "INFO"
  }
}
